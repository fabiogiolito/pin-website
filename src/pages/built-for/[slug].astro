---
import { Check, ShieldCheck, ArrowUpRight, CornerDownLeft, Video } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import FAQ from "../../components/ui/FAQ.astro";
import CTABand from "../../components/ui/CTABand.astro";
import { faqJsonLd } from "../../components/ui/faq";
import Autopilot from "../../components/Autopilot.astro";
import Avatar from "../../components/Avatar.astro";
import PinAvatar from "../../components/PinAvatar.astro";
import Journey from "../../components/segments/Journey.astro";
import ComparisonTable from "../../components/segments/ComparisonTable.astro";
import Testimonial from "../../components/segments/Testimonial.astro";
import { builtForPages } from "../../data/built-for";
import { segmentVisuals } from "../../data/built-for-visuals";
import { layouts } from "../../data/built-for-layout";

export function getStaticPaths() {
  return builtForPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const v = segmentVisuals[page.slug];
const sections = layouts[page.slug];
const url = `https://www.pin.com/built-for/${page.slug}/`;

const buildDate = new Date();
const lastUpdated = buildDate.toLocaleString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });

// Structured data ported from new-www: WebPage (+ speakable), FAQPage, BreadcrumbList.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: page.meta.title,
    url,
    description: page.meta.description,
    dateModified: buildDate.toISOString().slice(0, 10),
    speakable: { "@type": "SpeakableSpecification", cssSelector: ["h1", ".built-for-hero-description"] },
    mainEntity: { "@id": "https://www.pin.com/#software" },
    isPartOf: { "@id": "https://www.pin.com/#website" },
  },
  faqJsonLd(page.faq.items),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.pin.com" },
      { "@type": "ListItem", position: 2, name: page.meta.title, item: url },
    ],
  },
];

// Whole-number stats count up ("91%", "14 days"); anything else ("$250K+", "4.8/5") renders as-is.
const countable = (s: string) => s.match(/^(\d+)([^\d.,].*)?$/);
const booked = [v.match.lead.name, ...v.match.others.map(([n]) => n)];
const bookedTimes = ["Tue · 11:30 AM", "Wed · 2:00 PM", "Thu · 10:00 AM"];
const tile = "rounded-3xl bg-white p-7 shadow-[0_0_0_1px_rgb(0_0_0/0.04),0_10px_30px_-14px_rgb(115_70_38/0.18)]";
---

<Layout title={page.meta.title} description={page.meta.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto grid max-w-7xl gap-12 px-4 pb-20 pt-12 md:px-8 md:pt-20 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16">
    <div>
      <p data-reveal class="text-sm font-medium tracking-wide text-green">{page.hero.eyebrow}</p>
      <h1 data-reveal style="--i:1" class="mt-3 text-[40px] font-medium leading-[1.04] tracking-[-0.02em] text-balance md:text-[60px]" set:html={page.hero.title} />
      <p data-reveal style="--i:2" class="built-for-hero-description mt-6 max-w-xl text-lg leading-relaxed text-ink-2 text-pretty md:text-xl">{page.hero.description}</p>
      <div data-reveal style="--i:3" class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button signup arrow track="built_for_hero">Try Pin free</Button>
        <Button href="/book-a-demo/" variant="secondary" track="built_for_hero">Book a demo</Button>
      </div>
      <ul data-reveal style="--i:4" class="mt-6 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-2">
        {page.hero.badges.map((b) => <li class="inline-flex items-center gap-1.5"><Check size={14} class="text-green" /> {b}</li>)}
      </ul>
      {page.hero.stamps && (
        <ul data-reveal style="--i:5" class="mt-6 flex flex-wrap gap-2" aria-label="Compliance">
          {page.hero.stamps.map((s) => <li class="inline-flex items-center gap-1.5 rounded-full bg-green-lighter px-3 py-1 text-sm font-medium text-green-accessible"><ShieldCheck size={14} /> {s}</li>)}
        </ul>
      )}
    </div>

    <!-- What you type → what you get -->
    <div data-reveal style="--i:4" class="tint-sand rounded-[28px] px-4 py-8 text-[14px] sm:px-8 md:rounded-[36px] md:py-12">
      <p class="mb-3 text-sm font-medium text-ink-2">You type one line</p>
      <div class="panel p-4">
        <div class="flex items-center gap-2.5 rounded-xl border border-app-border bg-app-bg2 px-3 py-3 text-[15px]">
          <span class="min-w-0 flex-1">{v.brief.input}</span>
          <kbd class="grid size-6 shrink-0 place-items-center rounded-md bg-app-tint text-white"><CornerDownLeft size={13} /></kbd>
        </div>
        <div class="mt-3 flex gap-2.5 px-1 text-[13px]">
          <PinAvatar size={22} />
          <p>{v.brief.question}</p>
        </div>
      </div>
      <p class="mb-3 mt-7 text-sm font-medium text-ink-2">You get interviews</p>
      <div class="relative">
        <span class="callout absolute -top-4 right-4 z-10 hidden md:inline-flex">Pin did everything in between</span>
        <div class="panel p-4 pt-6">
          <p class="mb-3 flex items-center justify-between px-1 text-[12px] text-app-fg2"><span class="font-medium text-app-fg">This week</span><span>3 booked</span></p>
          <ul class="space-y-2">
            {booked.map((n, i) => (
              <li class="flex items-center gap-3 rounded-lg bg-app-tint/[0.07] px-3 py-2">
                <Avatar name={n} hue={[340, 25, 200][i]} size={28} />
                <div class="min-w-0 flex-1 text-[13px]">
                  <p class="truncate font-medium">Intro · {n}</p>
                  <p class="flex items-center gap-1 text-[11px] text-app-fg2"><Video size={11} /> {bookedTimes[i]}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="mt-4 text-right text-xs text-ink-3">Illustrative</p>
    </div>
  </section>

  {sections.map((s) => {
    if (s === "stats") return (
      <section class="bg-bg-secondary/60 py-20 md:py-24">
        <div class="mx-auto max-w-7xl px-4 md:px-8">
          <h2 data-reveal class="max-w-2xl text-[28px] font-medium leading-tight tracking-[-0.02em] text-balance md:text-[36px]">{page.stats.title}</h2>
          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {page.stats.items.map((st, i) => {
              const m = countable(st.value);
              return (
                <div data-reveal style={`--i:${i + 1}`} class:list={[tile, "flex flex-col justify-end"]}>
                  <p class="text-[48px] font-medium leading-none tracking-[-0.04em] tabular-nums md:text-[56px]">
                    {m ? <span data-count={m[1]} data-suffix={m[2] ?? ""}>{st.value}</span> : st.value}
                  </p>
                  <p class="mt-3 text-ink-2 text-pretty">{st.label}</p>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    );

    if (s === "journey") return <Journey title={page.journey.title} sub={page.journey.sub} steps={page.journey.steps} v={v} />;

    if (s === "useCases") return (
      <section class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
        <SectionHeader eyebrow="Use cases" title={page.useCases.title} align="left" />
        <div class="mt-12 grid gap-4 md:grid-cols-2">
          {page.useCases.items.map((u, i) => (
            <article data-reveal style={`--i:${i}`} class="flex flex-col rounded-3xl bg-bg-secondary/70 p-7 md:p-8">
              <h3 class="text-xl font-medium tracking-[-0.01em] text-balance">{u.heading}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-ink-2">{u.description}</p>
              <p class="mt-6 flex gap-2.5 rounded-2xl bg-white px-4 py-3 text-[15px] leading-snug">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-green text-white"><Check size={12} stroke-width={3} /></span>
                {u.outcome}
              </p>
            </article>
          ))}
        </div>
      </section>
    );

    if (s === "regulations" && page.regulations) return (
      <section class="bg-bg-secondary/60 py-24 md:py-32">
        <div class="mx-auto max-w-7xl px-4 md:px-8">
          <SectionHeader eyebrow="Compliance" title={page.regulations.title} sub={page.regulations.description} align="left" />
          <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {page.regulations.items.map((r, i) => (
              <article data-reveal style={`--i:${i}`} class={tile}>
                <ShieldCheck size={22} class="text-green" />
                <h3 class="mt-4 text-lg font-medium">{r.heading}</h3>
                <p class="mt-2 leading-relaxed text-ink-2">{r.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    );

    if (s === "autopilot") return <Autopilot />;

    if (s === "comparison" && page.comparison) return (
      <section class="mx-auto max-w-5xl px-4 py-24 md:px-8 md:py-32">
        <SectionHeader eyebrow="Compare" title={page.comparison.title} />
        <div data-reveal style="--i:3" class="mt-12">
          <ComparisonTable other={page.comparison.alternativeLabel} rows={page.comparison.criteria.map((c) => ({ label: c.label, pin: c.pin, other: c.alternative, note: c.note }))} />
        </div>
      </section>
    );

    if (s === "testimonial") return <Testimonial {...page.testimonial} />;

    if (s === "integrations") return (
      <section class="border-y border-ink/5">
        <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 py-16 md:px-8 md:py-20 lg:flex-row lg:items-center lg:justify-between">
          <div data-reveal class="max-w-md">
            <h2 class="text-[28px] font-medium leading-tight tracking-[-0.02em] text-balance md:text-[36px]">{page.integrations.title}</h2>
            <p class="mt-3 text-lg text-ink-2">120+ ATS integrations, plus your inbox, calendar and Slack.</p>
            <p class="mt-6 inline-flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-[0_0_0_1px_rgb(0_0_0/0.05)]"><ShieldCheck size={22} class="text-green" /><span><b class="block font-medium">SOC 2 Type 2</b><span class="text-sm text-ink-2">Your data and your candidates' data, protected.</span></span></p>
          </div>
          <ul data-reveal style="--i:1" class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:max-w-xl lg:flex-1">
            {page.integrations.items.map((it) => (
              <li class="rounded-2xl bg-white px-4 py-3 shadow-[0_0_0_1px_rgb(0_0_0/0.05)]"><span class="block font-medium">{it.name}</span><span class="block text-sm text-ink-3">{it.category}</span></li>
            ))}
          </ul>
        </div>
      </section>
    );

    if (s === "faq") return <FAQ items={page.faq.items} title={page.faq.title} />;

    if (s === "related") return (
      <section class="mx-auto max-w-7xl px-4 pb-24 md:px-8 md:pb-32">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <h2 data-reveal class="text-[28px] font-medium tracking-[-0.02em]">{page.siblings.title}</h2>
            <ul class="mt-6 space-y-3">
              {page.siblings.items.map((l, i) => (
                <li data-reveal style={`--i:${i + 1}`}>
                  <a href={l.href} class="group flex items-start justify-between gap-4 rounded-2xl bg-bg-secondary/70 p-5 transition-colors hover:bg-bg-secondary focus-visible:outline-2 focus-visible:outline-green">
                    <span><span class="block text-lg font-medium">{l.label}</span>{l.description && <span class="mt-1 block text-ink-2">{l.description}</span>}</span>
                    <ArrowUpRight size={18} class="mt-1 shrink-0 text-ink-3 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
          {page.related && (
            <div>
              <h2 data-reveal class="text-[28px] font-medium tracking-[-0.02em]">{page.related.title}</h2>
              <ul class="mt-6 divide-y divide-ink/8 border-y border-ink/8">
                {page.related.items.map((l, i) => (
                  <li data-reveal style={`--i:${i + 1}`}>
                    <a href={l.href} class="group flex items-start justify-between gap-4 py-4 focus-visible:outline-2 focus-visible:outline-green">
                      <span><span class="block font-medium group-hover:text-green-accessible">{l.label}</span>{l.description && <span class="mt-0.5 block text-sm text-ink-2">{l.description}</span>}</span>
                      <ArrowUpRight size={16} class="mt-1 shrink-0 text-ink-3" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    );
    return null;
  })}

  <CTABand title={page.cta.title} body={page.cta.body} track="built_for_final_cta" />
  <p class="mx-auto max-w-7xl px-4 pb-10 text-xs text-ink-3 md:px-8">Last updated: {lastUpdated}</p>
</Layout>

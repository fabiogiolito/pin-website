---
import Layout from "../../layouts/Layout.astro";
import { ArrowRight } from "@lucide/astro";

const title = "Pin Internal Tools";
const description = "Internal tools for the Pin team.";

const tools = [
  {
    name: "Quote Generator",
    href: "/internal/quotes/",
    description:
      "Build a multi-frame quote animation: intro logo, one or more customer quotes, and a closing CTA. Per-frame colors and durations, undo/redo, PNG or video export.",
    tag: "Social media",
  },
  {
    name: "Webinar Generator",
    href: "/internal/webinar/",
    description:
      "Create webinar promo images in card and banner sizes. Add a title with green highlights, speaker photos, and export both sizes as PNG.",
    tag: "Marketing",
  },
  {
    name: "Product Updates Generator",
    href: "/internal/product-updates/",
    description:
      "Create product update announcement images: label and title on the left, a screenshot on the right with rounded corners and shadow. Exports a 2000×1047 PNG.",
    tag: "Marketing",
  },
];

---

<Layout title={title} description={description} noindex={true}>
  <section class="mx-auto max-w-5xl px-4 py-16 md:px-8 md:py-24">
    <p class="text-sm font-medium tracking-wide text-green">Internal · noindex</p>
    <h1 class="mt-3 text-[40px] font-medium leading-[1.04] tracking-[-0.02em] text-balance md:text-[60px]">Pin Internal Tools</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-2 text-pretty">A collection of internal tools for the Pin team. More coming soon.</p>

    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group flex flex-col gap-3 rounded-3xl border border-ink/10 bg-white p-6 transition-[border-color,box-shadow] hover:border-green/30 hover:shadow-app focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green md:p-8"
        >
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-2xl font-medium tracking-[-0.02em] text-balance transition-colors group-hover:text-green-accessible">{tool.name}</h2>
            <span class="mt-1 shrink-0 rounded-full bg-green-lighter px-2.5 py-0.5 text-xs font-medium text-green-accessible">{tool.tag}</span>
          </div>
          <p class="leading-relaxed text-ink-2 text-pretty">{tool.description}</p>
          <span class="mt-auto inline-flex items-center gap-1.5 pt-2 font-medium text-green-accessible">
            Open tool <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>

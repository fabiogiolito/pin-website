---
import Layout from "../layouts/Layout.astro";
import { ChevronRight } from "@lucide/astro";
import { toolRegistry, toolSchemas, toolAnchorId, detectEmbeddedTools, type ToolSlug } from "../components/tools";
import { getAllBlogPostsForPaths } from "../lib/ghost";

// Dev-only: /tools is an internal directory and must not ship in production
// builds. In Astro 5 SSG, returning a non-200 response skips file emission,
// so this route exists under `pnpm dev` / `npm run dev` but is absent from
// the deployed Cloudflare Pages site.
if (import.meta.env.PROD) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const title = "Pin Tools (internal directory)";
const description = "Internal index of embeddable blog tools.";

// Build { slug -> [{ title, slug, published_at }] } map by scanning every post's
// HTML for embed tokens. Tolerate Ghost being unreachable (dev without env vars).
let postsByTool: Record<string, { title: string; slug: string; published_at?: string }[]> = {};
try {
  const posts = await getAllBlogPostsForPaths();
  const map: Record<string, { title: string; slug: string; published_at?: string }[]> = {};
  for (const post of posts) {
    const found = detectEmbeddedTools(post.html ?? "");
    for (const toolSlug of found) {
      (map[toolSlug] ??= []).push({
        title: post.title,
        slug: post.slug,
        published_at: post.published_at,
      });
    }
  }
  for (const list of Object.values(map)) {
    list.sort((a, b) => (b.published_at ?? "").localeCompare(a.published_at ?? ""));
  }
  postsByTool = map;
} catch (err) {
  console.warn("[/tools] Could not fetch Ghost posts for embedded-tool lookup:", err);
}

const tools = (Object.keys(toolRegistry) as ToolSlug[])
  .map((slug) => ({
    slug,
    cardId: `tool-${slug}`,
    anchor: toolAnchorId(slug),
    Component: toolRegistry[slug],
    posts: postsByTool[slug] ?? [],
    ...toolSchemas[slug],
  }))
  .sort((a, b) => a.tocLabel.localeCompare(b.tocLabel));
---

<Layout title={title} description={description} noindex={true}>
  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 py-12 md:px-8 md:py-16 lg:flex-row">
    <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:w-80 lg:shrink-0 lg:overflow-y-auto">
      <p class="text-sm font-medium tracking-wide text-green">Internal directory · noindex</p>
      <h1 class="mt-3 text-[40px] font-medium leading-[1.04] tracking-[-0.02em] text-balance">Pin Tools</h1>
      <p class="mt-2 text-ink-2">{tools.length} tool{tools.length === 1 ? "" : "s"} registered</p>

      <label for="tools-filter" class="sr-only">Filter tools</label>
      <input
        type="search"
        id="tools-filter"
        placeholder="Filter tools…"
        class="mt-6 w-full rounded-xl border border-ink/10 bg-white px-3.5 py-2.5 outline-none transition-colors placeholder:text-ink-3 focus:border-green focus-visible:ring-2 focus-visible:ring-green/25"
      />

      <nav aria-label="Tools directory" class="mt-3">
        <ul id="tools-nav" class="flex flex-col gap-0.5">
          {tools.map((t) => (
            <li data-tool-item data-tool-label={t.tocLabel.toLowerCase()} data-tool-slug={t.slug} class="flex items-start justify-between gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-bg-secondary">
              <span class="min-w-0 flex-1">
                <a href={`#${t.cardId}`} class="block font-medium leading-snug hover:text-green-accessible">{t.tocLabel}</a>
                <a
                  href={`https://www.pin.com/blog/${t.slug}/`}
                  target="_blank"
                  rel="noopener"
                  class="mt-0.5 block break-all font-mono text-xs text-ink-3 hover:text-green-accessible hover:underline"
                  title={`Open https://www.pin.com/blog/${t.slug}/ in new tab`}
                >{t.slug}</a>
              </span>
              <span class="mt-0.5 shrink-0 rounded-full bg-bg-tertiary px-2 py-0.5 text-xs font-medium tabular-nums text-ink-2" title={`Embedded in ${t.posts.length} post${t.posts.length === 1 ? "" : "s"}`}>
                {t.posts.length}
              </span>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <main class="min-w-0 flex-1">
      <p class="border-b border-ink/10 pb-6 text-ink-2 text-pretty">
        Directory of every tool registered in <code class="rounded bg-bg-tertiary px-1.5 py-0.5 text-sm">src/components/tools/index.ts</code>.
        Auto-populated from <code class="rounded bg-bg-tertiary px-1.5 py-0.5 text-sm">toolRegistry</code>. Post-usage counts come from a build-time Ghost fetch — the number next to each tool is how many published posts embed it.
      </p>

      <div class="mt-10 flex flex-col gap-8">
        {tools.map(({ slug, cardId, Component, name, description: toolDescription, applicationCategory, posts }) => (
          <section id={cardId} class="scroll-mt-24 rounded-3xl border border-ink/10 bg-white">
            <div class="flex flex-col gap-3 p-6 md:p-8">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h2 class="text-2xl font-medium tracking-[-0.02em] text-balance">{name}</h2>
                <span class="rounded-full bg-green-lighter px-3 py-1 text-xs font-medium text-green-accessible">{applicationCategory}</span>
              </div>
              <p class="text-ink-2 text-pretty">{toolDescription}</p>
              <dl class="mt-2 grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-[max-content_1fr]">
                <dt class="text-ink-3">Slug</dt>
                <dd>
                  <a href={`https://www.pin.com/blog/${slug}/`} target="_blank" rel="noopener" class="break-all rounded bg-bg-tertiary px-1.5 py-0.5 font-mono text-xs hover:text-green-accessible hover:underline">{slug}</a>
                </dd>
                <dt class="text-ink-3">TOC label</dt>
                <dd>{toolSchemas[slug].tocLabel}</dd>
                <dt class="text-ink-3">Embed token</dt>
                <dd><code class="rounded bg-bg-tertiary px-1.5 py-0.5 text-xs">{`[tool/${slug}]`}</code></dd>
                <dt class="text-ink-3">Used on</dt>
                <dd>
                  {posts.length === 0 ? (
                    <span class="text-ink-3">Not embedded in any published post yet</span>
                  ) : (
                    <ul class="flex flex-col gap-1">
                      {posts.map((p) => (
                        <li>
                          <a href={`/blog/${p.slug}/#${toolAnchorId(slug as ToolSlug)}`} class="text-green-accessible hover:underline" target="_blank" rel="noopener">{p.title}</a>
                          {p.published_at && <span class="ml-2 tabular-nums text-ink-3">{p.published_at.slice(0, 10)}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </dl>
            </div>

            <details class="group border-t border-ink/10" open>
              <summary class="flex cursor-pointer list-none items-center gap-2 px-6 py-4 text-sm font-medium text-ink-2 transition-colors hover:text-ink md:px-8 [&::-webkit-details-marker]:hidden">
                <ChevronRight size={16} class="transition-transform group-open:rotate-90" aria-hidden="true" />
                <span class="group-open:hidden">Show live preview</span>
                <span class="hidden group-open:inline">Hide live preview</span>
              </summary>
              <div class="px-4 pb-4 md:px-6 md:pb-6 [&>.pin-tool]:m-0!">
                <Component />
              </div>
            </details>
          </section>
        ))}
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById("tools-filter") as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLElement>("[data-tool-item]");
    input?.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      items.forEach((li) => {
        const label = li.dataset.toolLabel ?? "";
        const slug = li.dataset.toolSlug ?? "";
        li.style.display = !q || label.includes(q) || slug.includes(q) ? "" : "none";
      });
    });
  </script>
</Layout>

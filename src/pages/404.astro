---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";

const links = [
  { label: "How Pin works", href: "/" },
  { label: "Pricing", href: "/pricing/" },
  { label: "Customers", href: "/customers/" },
  { label: "Blog", href: "/blog/" },
];
---

<Layout title="Page Not Found - Pin" noindex={true}>
  <section class="mx-auto flex max-w-7xl flex-col items-center px-4 py-24 text-center md:px-8 md:py-36">
    <p class="text-sm font-medium tracking-wide text-green">404</p>
    <h1 class="mt-3 text-[40px] font-medium leading-[1.04] tracking-[-0.02em] text-balance md:text-[60px]">This page wasn't found.</h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2 text-pretty md:text-xl">
      The page you're looking for doesn't exist or may have been moved.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/" arrow track="404">Back to home</Button>
      <Button signup variant="secondary" track="404">Try Pin free</Button>
    </div>
    <nav aria-label="Popular pages" class="mt-14 flex flex-wrap justify-center gap-2">
      {links.map((l) => (
        <a href={l.href} class="rounded-full bg-bg-secondary px-4 py-2 text-sm text-ink-2 transition-colors hover:bg-sand hover:text-ink">{l.label}</a>
      ))}
    </nav>
  </section>
</Layout>

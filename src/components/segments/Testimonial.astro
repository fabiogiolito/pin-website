---
// Customer quote, quoted verbatim, with optional context paragraphs alongside.
import Avatar from "../Avatar.astro";
interface Props {
  quote: string;
  name: string;
  role: string;
  avatar?: string;
  paragraphs?: string[];
  eyebrow?: string;
}
const { quote, name, role, avatar, paragraphs = [], eyebrow = "From a customer" } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
  <div class:list={["grid gap-10 lg:gap-16", paragraphs.length && "lg:grid-cols-[1.3fr_1fr] lg:items-center"]}>
    <figure data-reveal class:list={["rounded-3xl bg-clay-light p-8 md:p-12", !paragraphs.length && "mx-auto max-w-4xl"]}>
      <p class="text-sm font-medium tracking-wide text-clay">{eyebrow}</p>
      <blockquote class="mt-5 text-[24px] font-medium leading-snug tracking-[-0.01em] text-balance md:text-[30px]">{quote}</blockquote>
      <figcaption class="mt-8 flex items-center gap-3">
        {avatar ? <img src={avatar} alt="" width="48" height="48" loading="lazy" class="size-12 rounded-full object-cover outline outline-1 -outline-offset-1 outline-black/10" /> : <Avatar name={name} size={48} />}
        <span><span class="block font-medium">{name}</span><span class="block text-sm text-ink-2">{role}</span></span>
      </figcaption>
    </figure>
    {paragraphs.length > 0 && (
      <div data-reveal style="--i:1" class="space-y-5 text-lg leading-relaxed text-ink-2 text-pretty">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    )}
  </div>
</section>

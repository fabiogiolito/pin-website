---
import { Video, CalendarCheck, ChevronLeft, ChevronRight } from "@lucide/astro";
import Chapter from "../Chapter.astro";
import Avatar from "../Avatar.astro";
import PinAvatar from "../PinAvatar.astro";

const days = ["Mon 26", "Tue 27", "Wed 28", "Thu 29", "Fri 30"];
const hours = ["10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM"];
// [day, startHourIndex, lengthInHours]
const busy = [[0, 0, 1], [1, 2, 1.5], [2, 0.5, 1], [3, 0, 1], [4, 3, 1], [2, 4, 1], [0, 5, 1]];
const intros = [
  { day: 3, at: 4, name: "Maya Chen", time: "2:00 PM" },
  { day: 1, at: 5, name: "Priya Raman", time: "3:00 PM" },
  { day: 4, at: 1, name: "Daniel Okafor", time: "11:00 AM" },
];
const ROW = 44;
---

<Chapter n={5} stage="Booked" title="They said yes. It's already on your calendar." tint="green">
  <p slot="copy">
    Pin offers times you're actually free, handles the back-and-forth, and sends the invite. You show up to the call.
  </p>

  <div id="booked" class="relative grid items-center gap-5 text-[14px] md:grid-cols-[0.8fr_1.4fr] md:gap-8">
    <div class="space-y-4">
      <!-- Reply with highlighted time -->
      <div class="relative">
      <span class="callout absolute -top-4 right-4 z-10 hidden md:inline-flex">Finds a time you're free</span>
      <div class="panel p-4 pt-6">
        <div class="flex items-center gap-2.5">
          <Avatar name="Maya Chen" hue={340} size={28} />
          <p class="text-[13px] text-app-fg2"><b class="font-semibold text-app-fg">Maya Chen</b> · 11:04 AM</p>
        </div>
        <p class="mt-3 leading-relaxed">That works for me. How about
          <span class="group relative cursor-help rounded-sm bg-app-pos/20 px-0.5 underline decoration-app-pos decoration-dashed underline-offset-2">Thursday at 2pm
            <span class="tip pointer-events-none absolute bottom-full right-0 z-10 mb-2 w-48 rounded-md bg-app-fg px-2 py-1 text-[12px] text-white sm:left-1/2 sm:right-auto sm:w-max sm:-translate-x-1/2">You are available Thu, Oct 29 at 2:00 PM</span>
          </span>?
        </p>
      </div>
      </div>
      <!-- Pin's confirmation -->
      <div class="panel p-4">
        <p class="flex items-center gap-2 text-[13px] text-app-fg2"><PinAvatar size={22} /> <b class="font-semibold text-app-fg">Pin</b> replied and sent the invite</p>
        <p class="mt-2 leading-relaxed text-app-fg2">"Perfect, Maya. You'll get an invite for Thursday at 2:00 PM. Talk then!"</p>
      </div>
    </div>

    <!-- Week view -->
    <div class="relative">
    <span class="callout absolute -bottom-4 right-4 z-10 hidden md:inline-flex"><CalendarCheck size={14} /> 3 interviews booked. Zero emails written by you.</span>
    <div class="panel overflow-hidden">
      <div class="flex items-center justify-between border-b border-app-border px-4 py-3">
        <p class="font-semibold">October 2026</p>
        <span class="flex items-center gap-1 text-app-fg3"><ChevronLeft size={16} /><span class="text-[13px] text-app-fg2">This week</span><ChevronRight size={16} /></span>
      </div>
      <div class="overflow-x-auto">
        <div class="min-w-[520px] p-3 text-[12px]">
          <div class="grid grid-cols-[48px_repeat(5,1fr)] text-app-fg2">
            <span></span>
            {days.map((d) => <span class="px-1.5 pb-2 font-medium">{d}</span>)}
          </div>
          <div class="relative grid grid-cols-[48px_repeat(5,1fr)]" style={`height:${hours.length * ROW}px`}>
            <div>{hours.map((h) => <p class="text-app-fg3" style={`height:${ROW}px`}>{h}</p>)}</div>
            {days.map((_, d) => (
              <div class="relative border-l border-app-border">
                {hours.map(() => <div class="border-t border-app-border" style={`height:${ROW}px`}></div>)}
                {busy.filter((b) => b[0] === d).map(([, s, l]) => (
                  <div class="absolute inset-x-1 rounded-md bg-app-fg/6" style={`top:${s * ROW + 2}px;height:${l * ROW - 4}px`}></div>
                ))}
                {intros.filter((e) => e.day === d).map((e) => (
                  <div class="intro absolute inset-x-1 flex flex-col justify-center overflow-hidden rounded-md bg-app-tint/12 px-2 leading-tight text-app-tint-fg" style={`top:${e.at * ROW + 2}px;height:${ROW - 4}px;--i:${intros.indexOf(e)}`}>
                    <p class="truncate text-[12px] font-semibold">{e.name}</p>
                    <p class="flex items-center gap-1 truncate text-[11px] opacity-75"><Video size={10} class="shrink-0" /> {e.time}</p>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</Chapter>

<style>
  .tip { opacity: 0; translate: 0 4px; transition: opacity 200ms, translate 200ms var(--ease-out-soft); }
  .group:hover .tip, .show-tip .tip { opacity: 1; translate: 0 0; }
  :global(.js) .intro { opacity: 0; translate: 0 -12px; scale: 0.96; transition: opacity 350ms, translate 450ms var(--ease-out-soft), scale 450ms var(--ease-out-soft); transition-delay: calc(var(--i) * 350ms + 900ms); }
  :global(.is-in) .intro { opacity: 1; translate: 0 0; scale: 1; }
</style>

<script>
  import { onEnter } from "../../scripts/motion";

  // Briefly show the availability tooltip when the reply first scrolls in.
  const root = document.getElementById("booked")!;
  onEnter(root, () => {
    root.classList.add("show-tip");
    setTimeout(() => root.classList.remove("show-tip"), 2600);
  }, 0.5);
</script>

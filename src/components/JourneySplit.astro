---
// Journey variant: chapter copy scrolls on the left, the matching visual stays pinned mid-screen on the right (lg+).
// Below lg it falls back to the stacked chapters.
import { stages } from "./stages";
import Brief from "./chapters/Brief.astro";
import Match from "./chapters/Match.astro";
import Outreach from "./chapters/Outreach.astro";
import Replies from "./chapters/Replies.astro";
import Booked from "./chapters/Booked.astro";
---

<div id="journey" class="relative">
  <div id="how" class="mx-auto max-w-7xl scroll-mt-16 px-4 pt-24 md:px-8 md:pt-32">
    <div class="mx-auto max-w-3xl text-center">
      <p data-reveal class="text-sm font-medium tracking-wide text-green">How Pin works</p>
      <h2 data-reveal style="--i:1" class="mt-3 text-[32px] font-medium leading-[1.1] tracking-[-0.02em] text-balance md:text-[48px]">
        One sentence in. Interviews out. Here's everything in between.
      </h2>
    </div>
  </div>

  <nav aria-label="Journey stages" class="sticky top-16 z-40 mt-10 flex justify-center border-b border-ink/5 bg-bg/85 px-4 py-2 backdrop-blur-md">
    <ol class="flex gap-0.5 overflow-x-auto rounded-full bg-white p-1 shadow-[0_0_0_1px_rgb(0_0_0/0.05)]">
      {stages.map((s, i) => (
        <li>
          <a href={`#${s.toLowerCase()}`} data-go={i} class="rail-item flex items-center whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium text-ink-3 transition-colors duration-300 hover:text-ink md:px-4">
            {s}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="split mx-auto max-w-7xl px-4 md:px-8">
    <div class="backdrop" aria-hidden="true"></div>
    <Brief />
    <Match />
    <Outreach />
    <Replies />
    <Booked />
  </div>
</div>

<style>
  .rail-item.on { background: var(--color-green); color: white; }
  .rail-item.done { color: var(--color-green-accessible); }

  .backdrop { display: none; }

  @media (min-width: 1024px) {
    .split { max-width: 1360px; overflow-x: clip; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 840px); column-gap: 4rem; padding-bottom: 10vh; }
    .split > :global([data-chapter]) { display: contents; }

    /* Copy: one tall row per chapter, content centered so it crosses mid-screen when its visual shows */
    .split > :global([data-chapter] > div:first-child) {
      grid-column: 1; grid-row: var(--n);
      min-height: 85vh; display: flex; flex-direction: column; justify-content: center; gap: 1.25rem;
      opacity: 0.35; transition: opacity 400ms var(--ease-out-soft);
    }
    .split > :global([data-chapter].active > div:first-child) { opacity: 1; }

    /* Visuals: one fixed-size panel shared by all chapters, pinned below the nav; only the active one is displayed.
       display:none keeps hidden ones out of IntersectionObserver, so their intro animations play when shown.
       Panels are transparent; the backdrop behind them carries the tint and eases between chapter colors. */
    .backdrop, .split > :global([data-chapter] > div:last-child) {
      grid-column: 2; grid-row: 1 / span 5; align-self: start;
      position: sticky; top: var(--top, 120px); margin-top: var(--mt, 0px); height: var(--ph, 80vh);
    }
    .backdrop { display: block; border-radius: 36px; transition: background-color 600ms var(--ease-out-soft); }
    .split > :global([data-chapter] > div:last-child) {
      padding: 0; display: none; background: transparent; translate: none; opacity: 1;
      transition: display 300ms allow-discrete;
    }
    .split > :global([data-chapter].active > div:last-child) { display: block; }

    /* Items leave quickly upward, then the next chapter's items rise in, staggered */
    .split :global(:is(.viz > div > *, .viz > p)) { transition: opacity 350ms var(--ease-out-soft), translate 500ms var(--ease-out-soft); transition-delay: 150ms; }
    .split :global(.viz > div > :nth-child(2)) { transition-delay: 230ms; }
    .split :global(.viz > div > :nth-child(n+3)) { transition-delay: 310ms; }
    .split :global(.viz > p) { transition-delay: 1500ms; } /* Replies summary line comes last, after the connection lines */
    .split :global([data-chapter]:not(.active) :is(.viz > div > *, .viz > p)) { opacity: 0; translate: 0 -14px; transition-duration: 200ms, 250ms; transition-delay: 0ms; }
    @starting-style {
      .split :global([data-chapter].active :is(.viz > div > *, .viz > p)) { opacity: 0; translate: 0 20px; }
    }
    /* Replies lines aren't part of the stagger: hidden until "lines:show" draws them at the cards' resting positions */
    .split :global(#replies-map .lines) { transition: none; opacity: 1; translate: none; }
    .split :global(#replies-map:not(.drawn) .lines) { visibility: hidden; }

    /* Content is laid out at the width that best matches the panel's shape, then scaled to fill it. */
    /* Per-chapter rearrangements for the panel's shape */
    .split :global(.viz > #brief) { align-items: center; }
    .split :global(#deck .card) { bottom: 0; overflow: hidden; }
    .split :global(#deck > div:first-child > .relative) { height: 400px; }
    /* Match: deck on top, Approved + Request review side by side below, tucked slightly under the stack */
    .split :global(.viz:has(> #deck)) { max-width: 820px; }
    .split :global(#deck) { grid-template-columns: 1fr; gap: 0; }
    .split :global(#deck > div:last-child) { display: grid; grid-template-columns: 1fr 1.15fr; align-items: start; gap: 20px; padding: 0 28px; margin-top: -16px; padding-top: 0; position: relative; z-index: 5; }
    .split :global(#deck > div:last-child > *) { margin-top: 0; }
    .split :global(#deck > div:last-child .panel) { box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05), 0 16px 40px -12px rgb(0 0 0 / 0.2); }
    /* Booked: calendar full width, taller calendar with the two messages side by side below it, equal height */
    .split :global(.viz > #booked) { display: flex; flex-direction: column; align-items: stretch; }
    .split :global(.viz > #booked > div:first-child) { order: 2; position: relative; z-index: 20; margin-top: 20px; padding: 0 40px; display: flex; align-items: stretch; gap: 28px; }
    .split :global(.viz > #booked > div:first-child > *) { flex: 1; margin: 0; display: flex; flex-direction: column; }
    .split :global(.viz > #booked > div:first-child > * > .panel) { flex: 1; }
    .split :global(.viz > #booked .cal) { --row: 58px; }
    .split :global(.viz > #booked) { min-width: 720px; }
    .split :global(.viz > #booked > div:first-child .panel) { box-shadow: 0 0 0 1px rgb(0 0 0 / 0.05), 0 16px 40px -12px rgb(0 0 0 / 0.25); }
    .split :global(.viz) { position: absolute; left: 50%; top: 50%; width: var(--dw, 1000px); min-width: min-content; transform: translate(-50%, -50%) scale(var(--s, 1)); }
  }
</style>

<script>
  const journey = document.getElementById("journey")!;
  const chapters = [...journey.querySelectorAll<HTMLElement>("[data-chapter]")];
  const items = [...journey.querySelectorAll<HTMLElement>(".rail-item")];
  // Sections are display:contents on desktop (no box), so track their copy blocks instead.
  const copies = chapters.map((c) => c.firstElementChild as HTMLElement);

  const split = journey.querySelector<HTMLElement>(".split")!;
  const backdrop = journey.querySelector<HTMLElement>(".backdrop")!;
  // Panels are transparent on desktop, so resolve each chapter's tint class on a probe element.
  const tints = chapters.map((c) => {
    const probe = document.createElement("div");
    probe.className = [...c.lastElementChild!.classList].find((k) => k.startsWith("tint-"))!;
    document.body.append(probe);
    const color = getComputedStyle(probe).backgroundColor;
    probe.remove();
    return color;
  });

  // Replies' connection lines: hidden when leaving, drawn (at the cards' final positions) once its cards have settled.
  const replies = journey.querySelector<HTMLElement>("#replies-map");
  const managed = matchMedia("(min-width: 1024px)");
  let linesTimer = 0;
  if (replies && managed.matches) replies.dataset.managed = "";

  function setActive(i: number) {
    const wasActive = chapters.findIndex((c) => c.classList.contains("active"));
    if (wasActive === i) return;
    chapters.forEach((c, j) => c.classList.toggle("active", j === i));
    if (replies && managed.matches) {
      clearTimeout(linesTimer);
      replies.dispatchEvent(new Event("lines:hide"));
      if (chapters[i].contains(replies)) linesTimer = window.setTimeout(() => replies.dispatchEvent(new Event("lines:show")), 850);
    }
    backdrop.style.backgroundColor = tints[i];
    items.forEach((el, j) => {
      el.classList.toggle("on", j === i);
      el.classList.toggle("done", j < i);
    });
  }

  // Size the shared panel to the space below the sticky nav, then pick the content width whose scaled result fills it best.
  const nav = journey.querySelector("nav")!;
  const PAD = 24;
  const MAX_SCALE = 0.85; // keep the UI at a natural, slightly reduced size instead of zoomed in
  function fit() {
    if (innerWidth < 1024) return;
    const navH = nav.getBoundingClientRect().height + 64;
    chapters.forEach((c) => {
      const panel = c.lastElementChild as HTMLElement;
      const viz = panel.querySelector<HTMLElement>(".viz")!;
      if (!panel.offsetWidth) return;
      const ph = Math.min(innerHeight - navH - 40, panel.offsetWidth * 0.78); // landscape panel, shorter when there's room
      split.style.setProperty("--ph", `${ph}px`);
      split.style.setProperty("--top", `${navH + (innerHeight - navH - ph) / 2}px`);
      split.style.setProperty("--mt", `${Math.max(0, (copies[0].offsetHeight - ph) / 2)}px`);
      // Try content widths; among those that scale nearly as large as the best, take the one that fills the panel most.
      const tries = [];
      for (let w = 640; w <= 1200; w += 40) {
        viz.style.setProperty("--dw", `${w}px`);
        const s = Math.min((panel.offsetWidth - PAD * 2) / viz.offsetWidth, (ph - PAD * 2) / viz.offsetHeight, MAX_SCALE);
        tries.push({ w, s, area: viz.offsetWidth * viz.offsetHeight * s * s });
      }
      const max = Math.max(...tries.map((t) => t.s));
      const best = tries.filter((t) => t.s >= max * 0.97).reduce((a, b) => (b.area > a.area ? b : a));
      viz.style.setProperty("--dw", `${best.w}px`);
      viz.style.setProperty("--s", String(best.s));
    });
  }
  const ro = new ResizeObserver(fit);
  chapters.forEach((c) => ro.observe(c.lastElementChild!));
  addEventListener("resize", fit);

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(copies.indexOf(e.target as HTMLElement))),
    { rootMargin: "-50% 0px -50% 0px" }
  );
  copies.forEach((c) => io.observe(c));
  setActive(0);

  // Anchors can't scroll to a display:contents section; center its copy block instead.
  items.forEach((a) => a.addEventListener("click", (e) => {
    e.preventDefault();
    copies[Number(a.dataset.go)].scrollIntoView({ behavior: "smooth", block: "center" });
  }));
</script>

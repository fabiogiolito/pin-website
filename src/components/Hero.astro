---
import { Check, Video, CornerDownLeft } from "@lucide/astro";
import Avatar from "./Avatar.astro";
import PinAvatar from "./PinAvatar.astro";
import Button from "./ui/Button.astro";
import DotGrid from "./DotGrid.astro";

const logos = [["expa", "Expa"], ["lithic", "Lithic"], ["paytient", "Paytient"], ["datapeoplesearch", "DataPeopleSearch"], ["pinpointtalent", "Pinpoint Talent"], ["gostaff", "GoStaff"]];
const work = [
  { n: 214, label: "matches found" },
  { n: 12, label: "approved by you" },
  { n: 12, label: "sequences sent" },
  { n: 9, label: "replies handled" },
];
const booked = [
  { name: "Maya Chen", hue: 340, when: "Thu · 2:00 PM" },
  { name: "Priya Raman", hue: 25, when: "Tue · 3:00 PM" },
  { name: "Daniel Okafor", hue: 200, when: "Fri · 11:00 AM" },
];
---

<section class="relative overflow-hidden">
  <DotGrid class="h-[620px] xl:h-[700px] 2xl:h-[780px]" people />

  <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-12 md:px-8 md:pb-24 md:pt-16 xl:pb-32 xl:pt-24 2xl:pt-32">
    <div data-dotgrid-avoid class="relative mx-auto max-w-3xl text-center">
      <p data-reveal class="inline-flex items-center gap-2 rounded-full border border-green/20 bg-white px-3 py-1 text-[13px] font-medium text-green-accessible">
        The AI recruiter for recruiters
      </p>
      <h1 data-reveal style="--i:1" class="mt-5 text-[36px] font-medium leading-[1.05] tracking-[-0.03em] text-balance md:text-[52px]">
        From job title to booked interviews.
      </h1>
      <p data-reveal style="--i:2" class="mx-auto mt-4 max-w-md text-lg leading-snug text-ink-2 text-pretty">
        Pin finds, reaches out, follows up and books the calls. You just show up.
      </p>
      <div data-reveal style="--i:3" class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <Button signup arrow track="hero">Try Pin free</Button>
        <Button href="/book-a-demo/" variant="secondary" track="hero">Book a demo</Button>
      </div>
    </div>

    <!-- Input → Pin → Output, readable at a glance -->
    <div class="depth-fan relative mt-14 grid gap-4 lg:grid-cols-[1fr_auto_1.1fr_auto_1fr] lg:items-stretch lg:gap-0 xl:mt-20 2xl:mt-24">
      <!-- You type -->
      <div data-reveal style="--i:5" class="flex flex-col">
        <p class="mb-3 text-center text-sm font-medium text-ink-2">You type one line</p>
        <div class="card flex flex-1 flex-col rounded-2xl bg-white p-4 font-app shadow-window">
          <div class="flex items-center gap-2.5 rounded-xl border border-app-border bg-app-bg2 px-3 py-3 text-[15px]">
            <span class="min-w-0 flex-1 text-app-fg">Senior Backend Engineer at ByteLogic<span class="caret ml-0.5 inline-block h-4 w-px translate-y-0.5 bg-app-fg"></span></span>
            <kbd class="grid size-6 shrink-0 place-items-center rounded-md bg-app-tint text-white"><CornerDownLeft size={13} /></kbd>
          </div>
          <div class="mt-4 flex gap-2.5 px-1 text-[13px] text-app-fg">
            <PinAvatar size={22} />
            <div>
              <p>Got it. I looked up ByteLogic. Should they be in NYC or remote?</p>
              <div class="mt-2 flex gap-1.5 text-[12px]">
                <span class="rounded-md border border-app-tint-fg bg-app-tint/5 px-2 py-0.5 text-app-tint-fg">NYC hybrid</span>
                <span class="rounded-md border border-app-border px-2 py-0.5 text-app-fg2">Remote</span>
              </div>
            </div>
          </div>
          <p class="mt-auto px-1 pt-4 text-[12px] text-app-fg3">No job description needed.</p>
        </div>
      </div>

      <div data-reveal style="--i:6" class="connector" aria-hidden="true"><span></span></div>

      <!-- Pin does the work -->
      <div data-reveal style="--i:6" class="flex flex-col">
        <p class="mb-3 text-center text-sm font-medium text-ink-2">Pin does the work</p>
        <div class="card card-main flex-1 rounded-2xl bg-white p-5 shadow-[0_0_0_2px_var(--color-green),0_16px_40px_-12px_rgb(74_122_90/0.35)]">
          <ul class="space-y-2.5">
            {work.map((w) => (
              <li class="flex items-center gap-3 rounded-lg bg-bg-tertiary px-3 py-2.5">
                <span class="grid size-5 shrink-0 place-items-center rounded-full bg-green text-white"><Check size={12} stroke-width={3} /></span>
                <span class="w-10 text-right text-lg font-medium tabular-nums"><span data-count={w.n}>{w.n}</span></span>
                <span class="text-ink-2">{w.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div data-reveal style="--i:7" class="connector" aria-hidden="true"><span></span></div>

      <!-- You get -->
      <div data-reveal style="--i:7" class="flex flex-col">
        <p class="mb-3 text-center text-sm font-medium text-ink-2">You get interviews</p>
        <div class="card flex-1 rounded-2xl bg-white p-4 font-app text-app-fg shadow-window">
          <p class="mb-3 flex items-center justify-between px-1 text-[12px] text-app-fg2"><span class="font-medium text-app-fg">This week</span><span>3 booked</span></p>
          <ul class="space-y-2">
            {booked.map((b) => (
              <li class="flex items-center gap-3 rounded-lg bg-app-tint/[0.07] px-3 py-2">
                <Avatar name={b.name} hue={b.hue} size={28} />
                <div class="min-w-0 flex-1 text-[13px]">
                  <p class="truncate font-medium">Intro · {b.name}</p>
                  <p class="flex items-center gap-1 text-[11px] text-app-fg2"><Video size={11} /> {b.when}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div data-reveal class="mt-16 xl:mt-24 2xl:mt-28 text-center">
      <p class="text-sm text-ink-3">Trusted by 10,000+ recruiters at 2,000+ companies</p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 opacity-60 grayscale md:gap-x-14">
        {logos.map(([file, name]) => <li><img src={`/images/companies/logo-${file}.png`} alt={name} class="h-6 w-auto md:h-7" loading="lazy" /></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .caret { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* Mobile: small vertical connector. Desktop: horizontal line with one slow traveling dot. */
  .connector { position: relative; height: 28px; width: 2px; margin-inline: auto; background: repeating-linear-gradient(to bottom, rgb(39 39 42 / 0.15) 0 4px, transparent 4px 8px); }
  .connector span { display: none; }
  @media (min-width: 1024px) {
    .connector { width: 48px; height: 2px; align-self: center; margin-top: 32px; background: repeating-linear-gradient(to right, rgb(39 39 42 / 0.18) 0 4px, transparent 4px 8px); }
    .connector span { display: block; position: absolute; top: -2px; left: 0; width: 6px; height: 6px; border-radius: 9999px; background: var(--color-green); animation: travel 3.2s ease-in-out infinite; }
  }
  @keyframes travel {
    0% { left: 0; opacity: 0; }
    20%, 80% { opacity: 1; }
    100% { left: calc(100% - 6px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret, .connector span { animation: none; }
  }

  @media (min-width: 1024px) {
    /* Side cards angle in toward the middle one, like a triptych */
    .depth-fan { perspective: 1400px; }
    .depth-fan > div:nth-child(1) .card { transform: rotateY(16deg) translateZ(-20px); transform-origin: right center; }
    .depth-fan > div:nth-child(5) .card { transform: rotateY(-16deg) translateZ(-20px); transform-origin: left center; }
    .depth-fan .card-main { transform: translateZ(30px); }
    .depth-fan .card { transition: transform 500ms var(--ease-out-soft); }
    .depth-fan:hover .card { transform: none; }
  }
</style>


---
// Feature-page section: heading row (eyebrow + title left, copy right), then content.
// With `tint`, the content sits on a flat tinted canvas like the homepage chapters.
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  tint?: "green" | "sand" | "purple" | "clay";
  class?: string;
}
const { id, eyebrow, title, tint, class: className = "" } = Astro.props;
---

<section id={id} class:list={["mx-auto max-w-7xl scroll-mt-24 px-4 py-16 md:px-8 md:py-24", className]}>
  <div class="grid gap-5 md:grid-cols-2 md:items-end md:gap-16">
    <div>
      {eyebrow && <p data-reveal class="text-sm font-medium tracking-wide text-green">{eyebrow}</p>}
      <h2 data-reveal style="--i:1" class="mt-3 text-[30px] font-medium leading-[1.08] tracking-[-0.02em] text-balance md:text-[44px]" set:html={title} />
    </div>
    <div data-reveal style="--i:2" class="space-y-3 text-lg leading-relaxed text-ink-2 text-pretty md:pb-1">
      <slot name="copy" />
    </div>
  </div>
  {tint ? (
    <div data-reveal style="--i:2" class:list={["relative mt-10 overflow-hidden rounded-[28px] px-4 py-8 sm:px-8 md:rounded-[36px] md:px-12 md:py-14", `tint-${tint}`]}>
      <slot />
    </div>
  ) : (
    <div class="mt-10"><slot /></div>
  )}
</section>

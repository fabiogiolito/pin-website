---
// Scheduling demo: pick a time as the candidate; Pin books it.
import { Video, Globe, RotateCcw } from "@lucide/astro";
import Avatar from "../Avatar.astro";
import PinAvatar from "../PinAvatar.astro";

const days = ["Mon 26", "Tue 27", "Wed 28", "Thu 29", "Fri 30"];
const hours = ["10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM"];
// [day, startHourIndex, lengthInHours]
const busy = [[0, 0, 1], [1, 2, 1.5], [2, 0.5, 1], [3, 0, 1], [4, 3, 1], [2, 4, 1], [0, 5, 1], [3, 5.5, 1]];
const slots = [
  { day: 1, at: 5, label: "Tue 2:00 PM", et: "3:00 PM ET" },
  { day: 3, at: 4, label: "Thu 1:00 PM", et: "2:00 PM ET" },
  { day: 4, at: 1, label: "Fri 10:00 AM", et: "11:00 AM ET" },
];
const ROW = 40;
---

<div id="scheduling-demo" class="tint-green rounded-[28px] px-4 py-8 text-left sm:px-8 md:rounded-[36px] md:px-12 md:py-12">
  <div class="mx-auto grid max-w-6xl items-start gap-5 text-[14px] [&>*]:min-w-0 lg:grid-cols-[0.85fr_1.3fr] lg:gap-8">
    <!-- Thread -->
    <div class="relative">
      <span class="callout absolute -top-4 right-4 z-10 hidden md:inline-flex">Only times you're free</span>
      <div class="panel space-y-4 p-4 pt-6 md:p-5 md:pt-7" aria-live="polite">
        <div class="flex gap-2.5">
          <Avatar name="Sara Kim" hue={280} size={28} />
          <p class="leading-relaxed"><b class="font-semibold">Sara Kim</b> <span class="text-[12px] text-app-fg3">10:05 AM</span><br />Yes! Would love to chat this week. What works?</p>
        </div>
        <div class="flex gap-2.5">
          <PinAvatar size={28} />
          <div>
            <p class="leading-relaxed"><b class="font-semibold">Pin</b> <span class="text-[12px] text-app-fg3">10:06 AM</span><br />Great to hear, Sara. Alex is free at any of these times, in your time zone (Chicago):</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {slots.map((s, i) => (
                <button type="button" data-slot={i} class="slot rounded-md bg-app-pos/10 px-2.5 py-1.5 font-medium text-app-pos transition-[background-color,scale] hover:bg-app-pos/20 active:scale-95 disabled:pointer-events-none disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-app-pos">{s.label}</button>
              ))}
            </div>
            <p class="hint mt-2 text-[12px] text-app-fg3">Click a time to reply as Sara</p>
          </div>
        </div>
        <div class="step-reply flex gap-2.5" hidden>
          <Avatar name="Sara Kim" hue={280} size={28} />
          <p class="leading-relaxed"><b class="font-semibold">Sara Kim</b> <span class="text-[12px] text-app-fg3">10:21 AM</span><br /><span class="picked"></span> works for me.</p>
        </div>
        <div class="step-done flex gap-2.5" hidden>
          <PinAvatar size={28} />
          <p class="leading-relaxed"><b class="font-semibold">Pin</b> <span class="text-[12px] text-app-fg3">10:21 AM</span><br />Perfect, Sara. You'll get an invite for <span class="picked"></span> with a Google Meet link. Talk then!</p>
        </div>
        <button type="button" class="reset inline-flex items-center gap-1.5 text-[13px] text-app-fg2 hover:text-app-fg" hidden><RotateCcw size={13} /> Start over</button>
      </div>
    </div>

    <!-- Week view -->
    <div class="relative">
      <span class="callout absolute -top-4 right-4 z-10 hidden md:inline-flex"><Globe size={14} /> Time zones handled</span>
      <div class="panel overflow-hidden">
        <div class="flex items-center justify-between border-b border-app-border px-4 py-3 pt-5">
          <p class="font-semibold">Alex's calendar</p>
          <span class="text-[13px] text-app-fg2">Your time (ET)</span>
        </div>
        <div class="overflow-x-auto">
          <div class="min-w-[520px] p-3 text-[12px]">
            <div class="grid grid-cols-[48px_repeat(5,1fr)] text-app-fg2">
              <span></span>
              {days.map((d) => <span class="px-1.5 pb-2 font-medium">{d}</span>)}
            </div>
            <div class="relative grid grid-cols-[48px_repeat(5,1fr)]" style={`height:${hours.length * ROW}px`}>
              <div>{hours.map((h) => <p class="text-app-fg3" style={`height:${ROW}px`}>{h}</p>)}</div>
              {days.map((_, d) => (
                <div class="relative border-l border-app-border">
                  {hours.map(() => <div class="border-t border-app-border" style={`height:${ROW}px`}></div>)}
                  {busy.filter((b) => b[0] === d).map(([, s, l]) => (
                    <div class="absolute inset-x-1 rounded-md bg-app-fg/6" style={`top:${s * ROW + 2}px;height:${l * ROW - 4}px`}></div>
                  ))}
                  {slots.map((s, i) => s.day === d && (
                    <div class="event absolute inset-x-1 flex flex-col justify-center overflow-hidden rounded-md px-2 leading-tight" data-event={i} style={`top:${s.at * ROW + 2}px;height:${ROW - 4}px`}>
                      <p class="name truncate text-[12px] font-semibold">Offered</p>
                      <p class="flex items-center gap-1 truncate text-[11px] opacity-75"><Video size={10} class="shrink-0" /> {s.et}</p>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="mt-6 text-center text-sm text-ink-3">Illustrative example</p>
</div>

<style>
  .event { border: 1.5px dashed hsl(142 97% 28% / 0.45); color: var(--color-app-pos); transition: opacity 300ms, background-color 300ms; }
  .event.booked { border-color: transparent; background: hsl(221 83% 53% / 0.12); color: var(--color-app-tint-fg); animation: pop 400ms var(--ease-out-soft); }
  .event.gone { opacity: 0; }
  @keyframes pop { from { scale: 0.92; } }
</style>

<script>
  const root = document.getElementById("scheduling-demo")!;
  const slotBtns = [...root.querySelectorAll<HTMLButtonElement>(".slot")];
  const events = [...root.querySelectorAll<HTMLElement>("[data-event]")];
  const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
  const LONG = ["Tuesday at 2:00 PM", "Thursday at 1:00 PM", "Friday at 10:00 AM"];
  let picked = -1;

  function book() {
    $(".step-done").hidden = false;
    events.forEach((e, j) => {
      e.classList.toggle("booked", j === picked);
      e.classList.toggle("gone", j !== picked);
      if (j === picked) e.querySelector(".name")!.textContent = "Intro · Sara Kim";
    });
  }

  function pick(i: number) {
    picked = i;
    slotBtns.forEach((b) => (b.disabled = true));
    $(".hint").hidden = true;
    root.querySelectorAll(".picked").forEach((el) => (el.textContent = LONG[i]));
    $(".step-reply").hidden = false;
    $(".reset").hidden = false;
    book();
  }

  function reset() {
    picked = -1;
    slotBtns.forEach((b) => (b.disabled = false));
    ["step-reply", "step-done", "reset"].forEach((c) => ($("." + c).hidden = true));
    $(".hint").hidden = false;
    events.forEach((e) => { e.classList.remove("booked", "gone"); e.querySelector(".name")!.textContent = "Offered"; });
  }

  slotBtns.forEach((b, i) => b.addEventListener("click", () => pick(i)));
  $(".reset").addEventListener("click", reset);
</script>

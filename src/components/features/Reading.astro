---
// "Keep reading" links to blog posts, carried over from new-www's related-resources block.
import { ArrowUpRight } from "@lucide/astro";
interface Props { items: { label: string; href: string; description: string }[] }
const { items } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pb-24 md:px-8 md:pb-32">
  <h2 data-reveal class="text-[28px] font-medium leading-tight tracking-[-0.02em] md:text-[36px]">Keep reading</h2>
  <ul class="mt-8 grid gap-3 md:grid-cols-3">
    {items.map((it, i) => (
      <li data-reveal style={`--i:${i + 1}`}>
        <a href={it.href} class="group flex h-full flex-col rounded-2xl bg-white p-6 shadow-[0_0_0_1px_rgb(0_0_0/0.05)] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green">
          <span class="flex items-start justify-between gap-4 text-lg font-medium leading-snug">{it.label}<ArrowUpRight size={18} class="mt-1 shrink-0 text-ink-3 transition-colors group-hover:text-green" /></span>
          <span class="mt-2 text-ink-2">{it.description}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

---
import Button from "./Button.astro";
interface Props {
  title?: string;
  body?: string;
  track?: string;
}
const {
  title = "Spend your time talking to candidates—not chasing them.",
  body = "Bring an open role to a 20-minute walkthrough with our team and watch Pin source, draft outreach, and set up your workflow live.",
  track = "final_cta",
} = Astro.props;
---

<section id="start" class="px-4 pb-24 md:px-8 md:pb-32">
  <div class="mx-auto max-w-7xl rounded-[28px] bg-bg-secondary px-6 py-20 text-center md:py-28">
    <h2 data-reveal class="mx-auto max-w-4xl text-[36px] font-medium leading-[1.05] tracking-[-0.02em] text-balance md:text-[60px]">{title}</h2>
    <p data-reveal style="--i:1" class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-2 text-pretty md:text-xl">{body}</p>
    <div data-reveal style="--i:2" class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <Button href="/book-a-demo/" arrow track={track}>Book a Demo With Our Team</Button>
      <Button signup variant="secondary" track={track}>Try Pin for Free</Button>
    </div>
    <p data-reveal style="--i:3" class="mt-6 text-sm text-ink-3">Free trial · No credit card</p>
  </div>
</section>

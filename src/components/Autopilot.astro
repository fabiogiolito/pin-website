---
import { Check, User, PenLine, SlidersHorizontal } from "@lucide/astro";

type Tone = "auto" | "draft" | "you";
const levels = [
  {
    name: "Hands-On Co-Pilot",
    desc: "Pin finds and ranks candidates and drafts every message. You approve each match, review each email, and book the calls yourself.",
  },
  {
    name: "Balanced Hybrid",
    desc: "You choose who gets contacted. Pin runs the outreach, answers questions it knows, checks with you on Slack for new ones, and suggests times.",
  },
  {
    name: "Full Autopilot",
    tag: "JD → Calendar",
    desc: "Go straight from a job description to interested candidates on your calendar, without doing any of the work in between.",
  },
];
// One row per stage: [label, tone] for each level, in the same order as `levels`.
const stages: { name: string; states: [string, Tone][] }[] = [
  { name: "Sourcing", states: [["Automated", "auto"], ["Automated", "auto"], ["Automated", "auto"]] },
  { name: "Match approval", states: [["You approve", "you"], ["You approve", "you"], ["Automated", "auto"]] },
  { name: "Sequences", states: [["You review", "draft"], ["Automated", "auto"], ["Automated", "auto"]] },
  { name: "FAQ replies", states: [["Drafted for you", "draft"], ["Automated", "auto"], ["Automated", "auto"]] },
  { name: "Scheduling", states: [["You book", "you"], ["Suggests times", "draft"], ["Automated", "auto"]] },
];
const DEFAULT = 1;
---

<section id="autopilot-section" class="bg-bg-secondary">
  <div class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <p data-reveal class="text-sm font-medium tracking-wide text-green">You're in control</p>
      <h2 data-reveal style="--i:1" class="mt-3 text-[32px] font-medium leading-[1.1] tracking-[-0.02em] text-balance md:text-[48px]">
        Automate as much or as little as you like.
      </h2>
      <p data-reveal style="--i:2" class="mt-5 text-lg leading-relaxed text-ink-2 text-pretty">
        Start hands-on and let Pin take over more as you build trust. Every step has its own switch.
      </p>
    </div>

    <div id="autopilot" data-level={DEFAULT} data-reveal style="--i:3" class="mx-auto mt-12 max-w-6xl rounded-3xl bg-white p-4 text-ink shadow-window sm:p-10 md:p-14">
      <!-- Level picker -->
      <div role="radiogroup" aria-label="Automation level" class="mx-auto flex w-full flex-col gap-1 rounded-2xl bg-bg-tertiary p-1 sm:w-fit sm:flex-row sm:rounded-full">
        {levels.map((l, i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === DEFAULT ? "true" : "false"}
            tabindex={i === DEFAULT ? 0 : -1}
            class="level cursor-pointer rounded-xl px-5 py-2.5 font-medium text-ink-2 transition-[background-color,color,box-shadow] duration-200 hover:text-ink aria-checked:bg-white aria-checked:text-ink aria-checked:shadow-[0_1px_2px_rgb(0_0_0/0.06),0_2px_8px_-2px_rgb(115_70_38/0.12)] sm:rounded-full"
          >
            {l.name}{l.tag && <span class="ml-1.5 font-normal text-ink-3">({l.tag})</span>}
          </button>
        ))}
      </div>

      <!-- Stages: one pipeline; each node shows who does the work at the selected level -->
      <ol class="track relative mt-16 grid gap-6 sm:grid-cols-5 sm:gap-2">
        {stages.map((s) => (
          <li class="stage relative flex items-center gap-4 sm:flex-col sm:gap-3 sm:text-center" data-tones={s.states.map(([, t]) => t).join(",")} data-tone={s.states[DEFAULT][1]}>
            <span class="node relative z-10 grid size-9 shrink-0 place-items-center rounded-full border transition-[background-color,border-color,color] duration-300">
              <Check size={16} stroke-width={2.5} class="i i-auto" />
              <PenLine size={15} class="i i-draft" />
              <User size={15} class="i i-you" />
            </span>
            <span class="flex flex-col gap-0.5 sm:items-center">
              <span class="font-medium">{s.name}</span>
              <span class="grid text-sm">
                {s.states.map(([label, tone], j) => (
                  <span class:list={["badge col-start-1 row-start-1 transition-[opacity,translate] duration-300", `tone-${tone}`]} data-for={j} aria-hidden={j === DEFAULT ? "false" : "true"}>{label}</span>
                ))}
              </span>
            </span>
          </li>
        ))}
      </ol>

      <!-- Description -->
      <div class="mt-14 grid text-center" aria-live="polite">
        {levels.map((l, j) => (
          <p class="desc col-start-1 row-start-1 mx-auto max-w-3xl text-lg leading-relaxed text-ink-2 transition-[opacity,translate] duration-300 text-pretty" data-for={j}>
            <b class="font-medium text-ink">{l.name}:</b> {l.desc}
          </p>
        ))}
      </div>

      <p class="mx-auto mt-10 flex w-fit items-center gap-2 rounded-full bg-bg-tertiary px-4 py-2 text-sm text-ink-2">
        <SlidersHorizontal size={14} /> Or mix and match: turn any step on or off in settings.
      </p>
    </div>
  </div>
</section>

<style>
  /* Connecting line: vertical on mobile, horizontal through the node centers on sm+ */
  .track::before { content: ""; position: absolute; left: 17px; top: 18px; bottom: 18px; width: 1px; background: rgb(39 39 42 / 0.12); }
  @media (min-width: 640px) { .track::before { left: 10%; right: 10%; top: 18px; bottom: auto; width: auto; height: 1px; } }

  /* Lucide renders the SVGs, so they don't carry this component's scope */
  .node :global(.i) { display: none; }
  .stage[data-tone="auto"] :global(.i-auto), .stage[data-tone="draft"] :global(.i-draft), .stage[data-tone="you"] :global(.i-you) { display: block; }
  .stage[data-tone="auto"] .node { background: var(--color-green); border-color: var(--color-green); color: white; }
  .stage[data-tone="draft"] .node { background: white; border-color: hsl(256 77% 60% / 0.45); color: hsl(256 60% 52%); }
  .stage[data-tone="you"] .node { background: white; border-color: rgb(39 39 42 / 0.2); color: var(--color-ink-2); }
  .tone-auto { color: var(--color-green-accessible); }
  .tone-draft { color: hsl(256 60% 48%); }
  .tone-you { color: var(--color-ink-3); }

  .badge, .desc { opacity: 0; translate: 0 4px; pointer-events: none; }
  [data-level="0"] [data-for="0"],
  [data-level="1"] [data-for="1"],
  [data-level="2"] [data-for="2"] { opacity: 1; translate: 0 0; pointer-events: auto; }
</style>

<script>
  const root = document.getElementById("autopilot")!;
  const radios = [...root.querySelectorAll<HTMLButtonElement>("[role=radio]")];
  const stages = [...root.querySelectorAll<HTMLElement>(".stage")];

  function select(i: number, focus = false) {
    root.dataset.level = String(i);
    radios.forEach((r, j) => {
      r.setAttribute("aria-checked", String(j === i));
      r.tabIndex = j === i ? 0 : -1;
    });
    if (focus) radios[i].focus();
    stages.forEach((s) => (s.dataset.tone = s.dataset.tones!.split(",")[i]));
    root.querySelectorAll<HTMLElement>(".badge").forEach((b) => b.setAttribute("aria-hidden", String(b.dataset.for !== String(i))));
  }

  radios.forEach((r, i) => r.addEventListener("click", () => select(i)));
  root.querySelector("[role=radiogroup]")!.addEventListener("keydown", (e) => {
    const k = (e as KeyboardEvent).key;
    const d = k === "ArrowRight" || k === "ArrowDown" ? 1 : k === "ArrowLeft" || k === "ArrowUp" ? -1 : 0;
    if (!d) return;
    e.preventDefault();
    select((Number(root.dataset.level) + d + radios.length) % radios.length, true);
  });
</script>

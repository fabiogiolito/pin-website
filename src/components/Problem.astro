---
import { Video } from "@lucide/astro";
import PinAvatar from "./PinAvatar.astro";

const days = ["Mon", "Tue", "Wed", "Thu", "Fri"];
const HOURS = 8; // 9 AM – 5 PM
const ROW = 38;
const tones = [
  "bg-clay-light text-clay",
  "bg-[#f8e7c8] text-[#7a5310]",
  "bg-[#f4dcdc] text-[#8f2f2f]",
  "bg-pearl text-ink-2",
];
// [day, start (hours after 9), length, label, left %, width %, rotate deg]
const chores: [number, number, number, string, number, number, number][] = [
  [0, 0, 1.5, "Boolean search", 0, 100, 0],
  [0, 1, 2, "Scroll 300 profiles", 25, 110, 2],
  [0, 3.5, 1.5, "Write intro emails", -6, 105, -2],
  [0, 4.5, 2.5, "Write more intro emails", 20, 115, 1.5],
  [1, 0, 1, "Follow up ×12", 0, 100, 0],
  [1, 0.6, 1.5, "Update the ATS", 30, 100, -3],
  [1, 2.5, 2, "Inbox triage", -8, 110, 2],
  [1, 4.2, 1.2, "Archive the no-thanks", 10, 120, -1.5],
  [1, 6, 2.6, "Chase the hiring manager", 0, 100, 3],
  [2, 0.3, 1.6, "Is it remote? ×9", 15, 105, -2],
  [2, 1.5, 2, "Find a time for 4 people", -10, 115, 1],
  [2, 3.8, 1, "Reschedule", 30, 90, 4],
  [2, 5, 2, "Follow up again", 0, 100, -1],
  [3, 0, 2.5, "Write the search string again", 5, 110, 1.5],
  [3, 2, 1.5, "LinkedIn messages", -12, 110, -2.5],
  [3, 5.5, 2.8, "More follow-ups", 20, 105, 2],
  [4, 0.4, 1.4, "Sourcing report", 0, 100, -1],
  [4, 1.4, 2, "Answer the same question", 25, 110, 2.5],
  [4, 4, 1.5, "Scheduling back-and-forth", -10, 120, -2],
  [4, 5.8, 2.6, "Write Monday's emails", 5, 105, 1],
];
// [day, start, name]
const meetings: [number, number, string][] = [
  [0, 1, "Maya Chen"], [1, 5, "Priya Raman"], [2, 2, "Daniel Okafor"], [3, 3, "Ana Souza"], [4, 1.5, "Jordan Park"],
];
// Chores pile on in a scattered order (index × 7 mod 20 hops across days), ~65ms apart.
const pileDelay = (label: string) => 250 + ((chores.findIndex((c) => c[3] === label) * 7) % chores.length) * 65;

---

<section id="problem" class="bg-bg-secondary/60">
  <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <h2 data-reveal class="text-[32px] font-medium leading-[1.1] tracking-[-0.02em] text-balance md:text-[48px]">
        Recruiting should be about people. Most of the week isn't.
      </h2>
      <p data-reveal style="--i:1" class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-2 text-pretty">
        Sourcing, chasing, sorting, scheduling. Pin takes the repetitive work so you can do the part only you can.
      </p>
    </div>

    <div data-reveal style="--i:2" class="mt-14">
      <!-- Busy vs calm calendar -->
      <div id="weeks" class="grid gap-10 font-app lg:grid-cols-2 lg:gap-12">
        {[false, true].map((calm) => (
          <div>
            <p class:list={["mb-3 font-sans text-sm font-medium", calm ? "text-green-accessible" : "text-ink-3"]}>{calm ? "Your week with Pin" : "Your week today"}</p>
            <div class="rounded-2xl bg-white p-3 shadow-[0_0_0_1px_rgb(0_0_0/0.05),0_16px_40px_-16px_rgb(84_68_58/0.22)]">
              <div class="grid grid-cols-5 pb-2 text-[12px] font-medium text-app-fg2">{days.map((d) => <span class="px-1">{d}</span>)}</div>
              <div class="relative grid grid-cols-5" style={`height:${HOURS * ROW}px`}>
                {days.map((_, d) => (
                  <div class="relative border-l border-app-border first:border-l-0">
                    {Array.from({ length: HOURS }).map(() => <div class="border-t border-app-border" style={`height:${ROW}px`}></div>)}
                    {!calm && chores.filter((c) => c[0] === d).map(([, s, l, label, x, w, r], k) => (
                      <div class:list={["ev chore absolute select-none overflow-hidden rounded-md px-1.5 py-1 text-[11px] font-medium leading-tight shadow-[0_1px_3px_rgb(0_0_0/0.12)]", tones[(d + k) % tones.length]]}
                        style={`top:${s * ROW + 1}px;height:${l * ROW - 2}px;left:${x}%;width:${w}%;rotate:${r}deg;z-index:${k + 1};--d:${pileDelay(label)}ms`}>{label}</div>
                    ))}
                    {meetings.filter((m) => m[0] === d).map(([, s, name]) => (
                      <div class:list={["ev absolute inset-x-1 flex flex-col justify-center overflow-hidden rounded-md px-1.5 leading-tight", calm ? "z-20 bg-green-lighter text-green-accessible" : "z-0 bg-green-lighter/70 text-green-accessible/70"]} style={`top:${s * ROW + 2}px;height:${ROW - 4}px;--d:${calm ? 500 + d * 160 : d * 40}ms`}>
                        <p class="truncate text-[11px] font-semibold">{name}</p>
                        <p class="flex items-center gap-1 truncate text-[10px] opacity-75"><Video size={9} class="shrink-0" /> Intro</p>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>
            {calm && <p class="cap mt-4 flex items-center gap-2 font-sans text-ink-2" style="--d:1400ms"><PinAvatar size={24} /> Just conversations. Everything else is handled.</p>}
            {!calm && <p class="cap mt-4 font-sans text-ink-3" style="--d:1900ms">Somewhere in there: five candidate calls.</p>}
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Events drop onto the calendars one at a time when the section scrolls in */
  :global(.js) #weeks .ev,
  :global(.js) #weeks .cap {
    opacity: 0;
    translate: 0 -10px;
    scale: 1.08;
  }
  #weeks.play .ev,
  #weeks.play .cap {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition:
      opacity 180ms ease-out,
      translate 320ms cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: var(--d, 0ms);
  }

  /* Draggable chores: follow the pointer, spring back on release */
  @media (pointer: fine) {
    .chore { cursor: grab; touch-action: none; }
  }
  .chore.lifted { z-index: 50 !important; }
  .chore.dragging {
    cursor: grabbing;
    box-shadow: 0 12px 28px -8px rgb(84 68 58 / 0.4);
    transition: none !important;
  }
  .chore.released {
    transition: transform 650ms linear(0, 0.36 8%, 0.9 18%, 1.1 26%, 1.13 31%, 1.08 39%, 0.99 52%, 0.98 59%, 1.005 75%, 1) !important;
  }
</style>

<script>
  import { onEnter } from "../scripts/motion";
  const weeks = document.getElementById("weeks")!;
  onEnter(weeks, () => weeks.classList.add("play"), 0.3);

  // Chores can be dragged around with a mouse/pen; on release they spring back to their slot.
  // ponytail: touch is left out so dragging doesn't hijack page scroll on phones
  weeks.querySelectorAll<HTMLElement>(".chore").forEach((el) => {
    let x0 = 0, y0 = 0;
    const move = (e: PointerEvent) => (el.style.transform = `translate(${e.clientX - x0}px, ${e.clientY - y0}px) scale(1.04)`);
    const up = () => {
      el.removeEventListener("pointermove", move);
      el.classList.replace("dragging", "released");
      el.style.transform = "";
      // stay on top until the spring settles, then drop back into the pile
      setTimeout(() => el.classList.contains("released") && el.classList.remove("lifted"), 650);
    };
    el.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") return;
      e.preventDefault();
      x0 = e.clientX; y0 = e.clientY;
      el.classList.remove("released");
      el.classList.add("dragging", "lifted");
      el.setPointerCapture(e.pointerId);
      el.addEventListener("pointermove", move);
      el.addEventListener("pointerup", up, { once: true });
      el.addEventListener("pointercancel", up, { once: true });
    });
  });
</script>

---
// The Pin agent's avatar: the logo mark on a soft green tile.
import PinMark from "../icons/pin-mark.svg";
interface Props { size?: number; class?: string }
const { size = 28, class: className = "" } = Astro.props;
---

<span class:list={["inline-grid shrink-0 place-items-center rounded-full bg-green-lighter text-green-accessible", className]} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <PinMark width={Math.round(size * 0.5)} height={Math.round(size * 0.57)} />
</span>

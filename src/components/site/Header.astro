---
import { ChevronDown, ChevronRight, Menu, X, ArrowRight, PlayCircle } from "@lucide/astro";
import Logo from "../../icons/logo.svg";
import { product, builtFor, compare } from "./nav";

const menus = [
  { label: "Product", links: product, layout: "product" },
  { label: "Built for", links: builtFor, layout: "grid" },
  { label: "Compare", links: compare, layout: "compare" },
];
const groups = (links: typeof builtFor) => [...new Set(links.map((l) => l.group))].map((g) => ({ title: g, links: links.filter((l) => l.group === g) }));
const badge = "rounded-full bg-green px-1.5 py-px text-[10px] font-semibold uppercase tracking-wide text-white";
---

<header
  id="site-header"
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
  class="sticky top-0 z-50 border-b border-transparent bg-bg/85 backdrop-blur-md transition-colors data-[scrolled=true]:border-ink/5"
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:px-8" aria-label="Main">
    <a href="/" aria-label="Pin homepage" class="text-ink"><Logo width={70} height={30} /></a>

    <!-- Desktop -->
    <ul class="hidden items-center gap-1 text-[15px] lg:flex">
      {menus.map((m) => (
        <li class="group relative">
          <button type="button" class="flex items-center gap-1 rounded-lg px-3 py-2 font-medium text-ink-2 transition-colors hover:text-ink group-focus-within:text-ink" aria-haspopup="true">
            {m.label} <ChevronDown size={14} class="transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" />
          </button>
          <div class:list={["invisible absolute top-full translate-y-1 opacity-0 transition-[opacity,visibility,translate] duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100", "left-0 pt-2"]}>
            <div class="overflow-hidden rounded-2xl bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.05),0_16px_40px_-12px_rgb(84_68_58/0.25)]">
              {m.layout === "compare" && <p class="px-5 pb-1 pt-4 text-xs font-medium uppercase tracking-wider text-ink-3">How Pin stacks up</p>}
              {m.layout === "grid" ? (
                <div class="grid w-[540px] grid-cols-2 divide-x divide-ink/5">
                  {groups(m.links).map((g) => (
                    <div class="p-2">
                      <p class="px-3 pb-1 pt-2 text-xs font-medium uppercase tracking-wider text-ink-3">{g.title}</p>
                      <ul>
                        {g.links.map((l) => (
                          <li>
                            <a href={l.href} class="group/item flex items-center gap-3 rounded-xl px-3 py-2 transition-colors hover:bg-bg-tertiary">
                              <span class="min-w-0 flex-1">
                                <span class="block font-medium text-ink">{l.label}</span>
                                <span class="mt-0.5 block text-sm leading-snug text-ink-2">{l.desc}</span>
                              </span>
                              <ChevronRight size={15} class="shrink-0 text-ink-3 transition-transform group-hover/item:translate-x-0.5" />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
              <ul class:list={["p-2", { "grid w-[620px] grid-cols-2": m.layout === "product", "w-72": m.layout === "compare" }]}>
                {m.links.map((l) => (
                  <li>
                    <a href={l.href} class:list={["group/item flex h-full gap-3 rounded-xl px-3 transition-colors hover:bg-bg-tertiary", m.layout === "product" ? "items-start py-2.5" : "items-center py-2"]}>
                      {l.icon && (
                        <span class:list={["grid shrink-0 place-items-center rounded-lg transition-colors group-hover/item:bg-green group-hover/item:text-white", m.layout === "product" ? "size-9 bg-green-lighter text-green-accessible" : "size-8 bg-bg-tertiary text-ink-2"]}>
                          <l.icon size={m.layout === "product" ? 17 : 15} />
                        </span>
                      )}
                      <span class="min-w-0">
                        <span class="flex items-center gap-2 font-medium text-ink">
                          {m.layout === "compare" ? <span><span class="font-normal text-ink-3">Pin vs</span> {l.label.replace("Pin vs ", "")}</span> : l.label}
                          {l.badge && <span class={badge}>{l.badge}</span>}
                        </span>
                        {l.desc && <span class="mt-0.5 block text-sm leading-snug text-ink-2">{l.desc}</span>}
                      </span>
                      {m.layout === "compare" && <ArrowRight size={14} class="ml-auto shrink-0 -translate-x-1 text-ink-3 opacity-0 transition-[opacity,translate] group-hover/item:translate-x-0 group-hover/item:opacity-100" />}
                    </a>
                  </li>
                ))}
              </ul>
              )}
              {m.layout === "product" && (
                <div class="flex items-center justify-between border-t border-ink/5 bg-bg-tertiary/60 px-5 py-3 text-sm">
                  <button type="button" @click="isDemoVideoOpen = true; $el.blur()" class="flex items-center gap-2 font-medium text-ink transition-colors hover:text-green-accessible"><PlayCircle size={16} class="text-green" /> See how Pin works</button>
                  <a href="/book-a-demo/" class="group/demo flex items-center gap-1 text-ink-2 transition-colors hover:text-ink">Book a demo <ArrowRight size={14} class="transition-transform group-hover/demo:translate-x-0.5" /></a>
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
      <li><a href="/customers/" class="rounded-lg px-3 py-2 font-medium text-ink-2 transition-colors hover:text-ink">Customers</a></li>
      <li><a href="/pricing/" class="rounded-lg px-3 py-2 font-medium text-ink-2 transition-colors hover:text-ink">Pricing</a></li>
      <li><a href="/blog/" class="rounded-lg px-3 py-2 font-medium text-ink-2 transition-colors hover:text-ink">Blog</a></li>
    </ul>

    <div class="flex items-center gap-1 text-[15px] md:gap-2">
      <a href="https://app.pin.com/login" class="hidden rounded-lg px-3 py-2 font-medium text-ink-2 transition-colors hover:bg-ink/5 hover:text-ink sm:block"
        onclick="window.dataLayer?.push({ event: 'sign_in_clicked', location: 'header', page: window.location.pathname })">Sign in</a>
      <button type="button" class="rounded-xl bg-green px-4 py-2.5 font-medium text-white transition-[background-color,scale] hover:bg-green-accessible active:scale-[0.98]"
        @click="isLoginModalOpen = true; window.dataLayer?.push({ event: 'start_free_clicked', location: 'header', page: window.location.pathname })">Try Pin Free</button>
      <button type="button" class="grid size-10 place-items-center rounded-lg text-ink-2 lg:hidden" @click="open = !open" :aria-expanded="open" aria-label="Menu">
        <span x-show="!open"><Menu size={20} /></span>
        <span x-show="open" style="display:none"><X size={20} /></span>
      </button>
    </div>
  </nav>

  <!-- Mobile -->
  <div x-show="open" x-transition.opacity style="display:none" class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-ink/5 bg-bg px-4 pb-8 lg:hidden">
    {menus.map((m) => (
      <div class="border-b border-ink/5 py-4">
        <p class="mb-2 text-sm font-medium text-ink-3">{m.label}</p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1">
          {m.links.map((l) => <li><a href={l.href} class="flex items-center gap-2 py-1.5 text-ink">{l.label}{l.badge && <span class={badge}>{l.badge}</span>}</a></li>)}
        </ul>
      </div>
    ))}
    <ul class="grid grid-cols-2 gap-x-4 gap-y-1 py-4">
      <li><a href="/customers/" class="block py-1.5 text-ink">Customers</a></li>
      <li><a href="/pricing/" class="block py-1.5 text-ink">Pricing</a></li>
      <li><a href="/blog/" class="block py-1.5 text-ink">Blog</a></li>
      <li><a href="https://app.pin.com/login" class="block py-1.5 text-ink">Sign in</a></li>
    </ul>
  </div>
</header>

---
// Legal pages: renders src/content/<slug>.md with readable prose styles.
import Layout from "../../layouts/Layout.astro";

interface Props {
  contentSlug: string;
  noindex?: boolean;
  title?: string;
  description?: string;
}
const { contentSlug, noindex = false, title, description } = Astro.props;

const modules = import.meta.glob<any>("../../content/*.md", { eager: true });
const entry = Object.entries(modules).find(([p]) => p.endsWith(`/${contentSlug}.md`));
if (!entry) throw new Error(`Content not found: ${contentSlug}`);
const Content = entry[1].Content;
---

<Layout noindex={noindex} title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 pb-24 pt-12 md:px-8 md:pb-32 md:pt-20">
    <article class="prose mx-auto max-w-[720px]">
      <Content />
    </article>
  </div>
</Layout>

<style>
  .prose {
    color: var(--color-ink-2);
    font-size: 17px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .prose :global(h1) {
    color: var(--color-ink);
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: 1.5rem;
  }
  .prose :global(h2) {
    color: var(--color-ink);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 3.5rem 0 1rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgb(39 39 42 / 0.08);
  }
  .prose :global(h3) {
    color: var(--color-ink);
    font-size: 19px;
    font-weight: 500;
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(pre) { margin-bottom: 1.1rem; }
  .prose :global(strong) { color: var(--color-ink); font-weight: 500; }
  .prose :global(a) {
    color: var(--color-green-accessible);
    text-decoration: underline;
    text-decoration-color: rgb(74 122 90 / 0.35);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) { text-decoration-color: var(--color-green); }
  .prose :global(ul) { list-style: disc; padding-left: 1.4rem; }
  .prose :global(ol) { list-style: decimal; padding-left: 1.4rem; }
  .prose :global(li) { margin-bottom: 0.5rem; padding-left: 0.25rem; }
  .prose :global(li::marker) { color: var(--color-ink-3); }
  .prose :global(li > p) { margin-bottom: 0.4rem; }
  .prose :global(blockquote) {
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.1rem;
  }
  .prose :global(code) {
    background: var(--color-bg-tertiary);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    font-size: 0.9em;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid rgb(39 39 42 / 0.12);
    padding: 0.6rem 0.85rem;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) { color: var(--color-ink); font-weight: 500; background: var(--color-bg-secondary); }
  .prose :global(hr) { border-color: rgb(39 39 42 / 0.08); margin: 2.5rem 0; }
</style>

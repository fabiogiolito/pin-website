---
// Full-width chapter: heading row on top, then a tinted canvas holding loose pieces of product UI.
interface Props {
  n: number;
  stage: string;
  title: string;
  tint: "green" | "sand" | "purple" | "clay";
}
const { n, stage, title, tint } = Astro.props;
---

<section data-chapter={n - 1} id={stage.toLowerCase()} style={`--n:${n}`} class="scroll-mt-28 py-14 md:py-20">
  <div class="grid gap-5 md:grid-cols-2 md:items-end md:gap-16">
    <div>
      <p data-reveal class="text-sm font-medium tracking-wide text-green">0{n} · {stage}</p>
      <h2 data-reveal style="--i:1" class="mt-3 text-[30px] font-medium leading-[1.08] tracking-[-0.02em] text-balance md:text-[44px]">{title}</h2>
    </div>
    <div data-reveal style="--i:2" class="space-y-3 text-lg leading-relaxed text-ink-2 text-pretty md:pb-1">
      <slot name="copy" />
    </div>
  </div>
  <div data-reveal style="--i:2" class:list={["relative mt-10 overflow-hidden rounded-[28px] px-4 py-8 sm:px-8 md:rounded-[36px] md:px-12 md:py-14", `tint-${tint}`]}>
    <div class="viz"><slot /></div>
  </div>
</section>
